	"authors": [
		"six-hertz666"
	],
	"contact": {
		"homepage": "https://github.com/six-hertz666/Hertz-s-Abstract-MC-Mod",
		"sources": "https://github.com/six-hertz666/Hertz-s-Abstract-MC-Mod"
	},
	"license": "MIT",
	"icon": "assets/hertzsabstract/icon.png",
